{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "computed_at": {
      "type": "string"
    },
    "window": {
      "type": "string",
      "enum": [
        "15m",
        "60m",
        "4h"
      ]
    },
    "window_from": {
      "type": "number"
    },
    "window_to": {
      "type": "number"
    },
    "head_block": {
      "type": [
        "number",
        "null"
      ]
    },
    "lag_blocks": {
      "type": [
        "number",
        "null"
      ]
    },
    "source": {
      "type": "object",
      "properties": {
        "rpc": {
          "type": "string"
        },
        "mode": {
          "type": "string",
          "enum": [
            "cold",
            "cache",
            "live"
          ]
        }
      },
      "required": [
        "rpc",
        "mode"
      ],
      "additionalProperties": false
    },
    "reading": {
      "type": "string"
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "slug": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "HOT",
              "EMERGING",
              "ROTATING IN",
              "ROTATING OUT",
              "COOLING",
              "DEAD"
            ]
          },
          "id": {
            "type": "string"
          },
          "first_seen_ts": {
            "type": "number"
          }
        },
        "required": [
          "slug",
          "status",
          "id",
          "first_seen_ts"
        ],
        "additionalProperties": false
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "wallets": {
            "type": "number"
          },
          "quote_norm": {
            "type": "number"
          },
          "deployers": {
            "type": "number"
          }
        },
        "required": [
          "from",
          "to",
          "wallets",
          "quote_norm",
          "deployers"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "computed_at",
    "window",
    "window_from",
    "window_to",
    "head_block",
    "lag_blocks",
    "source",
    "nodes",
    "edges"
  ],
  "additionalProperties": false
}
