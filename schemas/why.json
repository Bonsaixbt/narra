          "deployers": {
            "type": "number"
          },
          "moves": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "wallet": {
                  "type": "string"
                },
                "token": {
                  "type": "string"
                },
                "symbol": {
                  "type": "string"
                },
                "ts": {
                  "type": "number"
                },
                "eth": {
                  "type": "number"
                },
                "tx": {
                  "type": "string"
                }
              },
              "required": [
                "wallet",
                "token",
                "ts",
                "eth",
                "tx"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "from",
          "to",
          "wallets",
          "quote_norm",
          "deployers"
        ],
        "additionalProperties": false
      }
    },
    "edges_out": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "wallets": {
            "type": "number"
          },
          "quote_norm": {
            "type": "number"
          },
          "deployers": {
            "type": "number"
          },
          "moves": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "wallet": {
                  "type": "string"
                },
                "token": {
                  "type": "string"
                },
                "symbol": {
                  "type": "string"
                },
                "ts": {
                  "type": "number"
                },
                "eth": {
                  "type": "number"
                },
                "tx": {
                  "type": "string"
                }
              },
              "required": [
                "wallet",
                "token",
                "ts",
                "eth",
                "tx"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "from",
          "to",
          "wallets",
          "quote_norm",
          "deployers"
        ],
        "additionalProperties": false
      }
    },
    "rule": {
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "computed_at",
    "window",
    "window_from",
    "window_to",
    "head_block",
    "lag_blocks",
    "source",
    "cluster",
    "tags",
    "edges_in",
    "edges_out",
    "rule"
  ],
  "additionalProperties": false
}
