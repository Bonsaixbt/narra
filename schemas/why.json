      "required": [
        "slug",
        "label",
        "status",
        "top_tags",
        "id",
        "first_seen_ts",
        "n_members",
        "heat",
        "links",
        "narrative",
        "narrative_sub",
        "narrative_mix",
        "flow",
        "rank",
        "rotating_from",
        "rotating_to"
      ],
      "additionalProperties": false
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "tag": {
            "type": "string"
