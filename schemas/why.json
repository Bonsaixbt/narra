          "required": [
            "n_launches",
            "n_members",
            "n_alive",
            "quote_norm_in",
            "unique_buyers",
            "n_graduated",
            "graduated_share",
            "taxed_ratio",
            "pool_volume_norm",
            "delta_pct",
            "pair_mix"
          ],
          "additionalProperties": false
        },
        "links": {
          "type": "object",
          "properties": {
            "text": {
              "type": "number"
            },
            "wallet": {
              "type": "number"
            },
            "deployer": {
              "type": "number"
            },
            "semantic": {
              "type": "number"
            }
          },
          "required": [
            "text",
            "wallet",
            "deployer",
            "semantic"
          ],
          "additionalProperties": false
        },
        "summary": {
          "type": "string"
        },
        "label_source": {
          "type": "string",
          "enum": [
            "tags",
            "model",
            "cache"
          ]
        },
        "narrative": {
          "type": "string"
        },
        "narrative_sub": {
          "type": [
            "string",
            "null"
          ]
        },
        "narrative_mix": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "number"
          }
        },
        "flow": {
          "type": "object",
          "properties": {
            "in_wallets": {
              "type": "number"
            },
            "in_eth": {
              "type": "number"
            },
            "out_wallets": {
              "type": "number"
            },
            "out_eth": {
              "type": "number"
            }
          },
          "required": [
            "in_wallets",
            "in_eth",
            "out_wallets",
            "out_eth"
          ],
          "additionalProperties": false
        },
        "rank": {
          "type": "number"
        },
        "cohorts": {
          "type": "object",
          "properties": {
            "sniper": {
              "type": "number"
            },
            "sprayer": {
              "type": "number"
            },
            "rotator": {
              "type": "number"
            },
            "early-in-hot": {
              "type": "number"
            },
            "total": {
              "type": "number"
            }
          },
          "required": [
            "sniper",
            "sprayer",
            "rotator",
            "early-in-hot",
            "total"
          ],
          "additionalProperties": false
        },
        "rotating_from": {
          "type": [
            "string",
            "null"
          ]
        },
        "rotating_to": {
          "type": [
            "string",
            "null"
          ]
        },
        "members": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "token": {
                "type": "string"
              },
              "symbol": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "phase": {
                "type": "string",
                "enum": [
                  "curve",
                  "swept",
                  "pool",
                  "rescued"
                ]
              },
              "curve_progress": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "membership": {
                "type": "number"
              },
              "buyers_overlap": {
                "type": "number"
              },
              "last_trade_ts": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "launched_ts": {
                "type": "number"
              }
            },
            "required": [
              "token",
              "symbol",
              "name",
              "phase",
              "curve_progress",
              "membership",
              "buyers_overlap",
              "last_trade_ts",
              "launched_ts"
            ],
            "additionalProperties": false
          }
        }
