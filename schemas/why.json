{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "computed_at": {
      "type": "string"
    },
    "window": {
      "type": "string",
      "enum": [
        "15m",
        "60m",
        "4h"
      ]
    },
    "window_from": {
      "type": "number"
    },
    "window_to": {
      "type": "number"
    },
    "head_block": {
      "type": [
        "number",
        "null"
      ]
    },
    "lag_blocks": {
      "type": [
        "number",
        "null"
      ]
    },
    "source": {
      "type": "object",
      "properties": {
        "rpc": {
          "type": "string"
        },
        "mode": {
          "type": "string",
          "enum": [
            "cold",
            "cache",
            "live"
          ]
        }
      },
      "required": [
        "rpc",
        "mode"
      ],
      "additionalProperties": false
    },
    "reading": {
      "type": "string"
    },
    "cluster": {
      "type": "object",
      "properties": {
        "slug": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "HOT",
            "EMERGING",
            "ROTATING IN",
            "ROTATING OUT",
            "COOLING",
            "DEAD"
          ]
        },
        "top_tags": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "tag": {
                "type": "string"
              },
              "weight": {
                "type": "number"
              }
            },
            "required": [
              "tag",
              "weight"
            ],
            "additionalProperties": false
          }
        },
        "id": {
          "type": "string"
        },
        "first_seen_ts": {
          "type": "number"
        },
        "n_members": {
          "type": "number"
        },
        "heat": {
          "type": "object",
          "properties": {
            "n_launches": {
              "type": "number"
            },
            "n_members": {
              "type": "number"
            },
            "n_alive": {
              "type": "number"
            },
            "quote_norm_in": {
              "type": "number"
            },
            "unique_buyers": {
              "type": "number"
            },
            "n_graduated": {
              "type": "number"
            },
            "graduated_share": {
              "type": "number"
            },
            "taxed_ratio": {
              "type": "number"
            },
            "pool_volume_norm": {
              "type": "number"
            },
            "delta_pct": {
              "type": [
                "number",
                "null"
              ]
            },
            "pair_mix": {
              "type": "object",
              "properties": {
                "eth": {
                  "type": "number"
                },
                "stable": {
                  "type": "number"
                },
                "stock": {
                  "type": "number"
                },
                "other": {
                  "type": "number"
                }
              },
              "required": [
                "eth",
                "stable",
                "stock",
                "other"
              ],
              "additionalProperties": false
            }
