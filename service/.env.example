# The engine reads the same variables as narra-cli (.env in this folder or ~/.narra/.env): NARRA_RPC_URL, NARRA_WS_URL, NARRA_DB, NARRA_RETENTION_H, NARRA_SEMANTIC_*
NARRA_RETENTION_H=168
NARRA_API_PORT=4663
NARRA_API_HOST=0.0.0.0
NARRA_API_ORIGIN=https://narra.example        # CORS origin of the site; empty allows any (dev only)
NARRA_TOKEN_ADDRESS=                            # $NARRA contract; empty = every route open
NARRA_HOLDER_THRESHOLD=500000
NARRA_HOLDER_SECRET=                            # long random string; required once the token exists
NARRA_HOLDER_TTL_S=86400
NARRA_RATE_ANON=60
NARRA_RATE_HOLDER=600
NARRA_PUBLIC_STREAM_DELAY_S=300
NARRA_TICK_S=30
NARRA_WINDOWS=60m,15m,4h
NARRA_SLOW_WINDOW_EVERY_S=300
# /api/trend (48 h, 4 h steps) is precomputed in the worker this often
NARRA_TREND_EVERY_S=900

# Telegram alerts (optional): a bot token and one or more chat ids; events STATUS (HOT / ROTATING IN / OUT), EDGE (≥ 8 wallets), GRAD
NARRA_TG_BOT_TOKEN=
NARRA_TG_CHAT_IDS=
NARRA_TG_EVENTS=STATUS,EDGE,GRAD
# Alerts go out as one digest per NARRA_TG_ALERT_BATCH_S (HOT/rotating metas, biggest moves, graduations); nothing during the first NARRA_TG_ALERT_WARMUP_S after a start
NARRA_TG_ALERT_BATCH_S=300
NARRA_TG_ALERT_WARMUP_S=90
# Links in Telegram messages (metas, coins, the board) point here; defaults to NARRA_API_ORIGIN
NARRA_SITE_URL=https://narrahood.com
NARRA_TG_DEDUPE_S=600
NARRA_TG_PER_MINUTE=20
NARRA_TG_DELAY_S=0                              # set 300 for a public channel, like the public stream

# Community bot (same bot token): a digest every NARRA_TG_DIGEST_EVERY_S to the community chats, and /meta /coin /find /flow /trend commands
NARRA_TG_COMMUNITY_CHAT_IDS=                    # where the digest goes (channel or group ids)
NARRA_TG_ALLOWED_CHAT_IDS=                      # commands answered only in these chats; empty = anywhere the bot is
NARRA_TG_DIGEST_EVERY_S=1800
NARRA_TG_COMMANDS=on

# Cloudflare named tunnel: no env needed. Put the tunnel credentials JSON at
# service/cloudflared/credentials.json (see deploy/VPS.md), then
# `docker compose --profile tunnel up -d tunnel`.
