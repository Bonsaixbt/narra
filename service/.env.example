# The engine reads the same variables as narra-cli (.env in this folder or ~/.narra/.env): NARRA_RPC_URL, NARRA_WS_URL, NARRA_DB, NARRA_RETENTION_H, NARRA_SEMANTIC_*
NARRA_RETENTION_H=168
NARRA_API_PORT=4663
NARRA_API_HOST=0.0.0.0
NARRA_API_ORIGIN=https://narra.example        # CORS origin of the site; empty allows any (dev only)
NARRA_TOKEN_ADDRESS=                            # $NARRA contract; empty = every route open
NARRA_HOLDER_THRESHOLD=500000
NARRA_HOLDER_SECRET=                            # long random string; required once the token exists
NARRA_HOLDER_TTL_S=86400
NARRA_RATE_ANON=60
NARRA_RATE_HOLDER=600
NARRA_PUBLIC_STREAM_DELAY_S=300
NARRA_TICK_S=30
NARRA_WINDOWS=60m,15m,4h
NARRA_SLOW_WINDOW_EVERY_S=300
