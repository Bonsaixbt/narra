# Copy to .env (project) or ~/.narra/.env (user). Never commit .env.

# Private RPC first, public official node as a logs-capable fallback. "#nologs" marks an endpoint that refuses eth_getLogs.
NARRA_RPC_URL=https://YOUR-CHAINSTACK-NODE/KEY,https://rpc.mainnet.chain.robinhood.com
# WebSocket for subscriptions (v0.2). "off" disables.
NARRA_WS_URL=wss://YOUR-CHAINSTACK-NODE/ws/KEY

# Cache location and raw-trade retention in hours.
NARRA_DB=~/.narra/narra.db
NARRA_RETENTION_H=48

# Set to 1 to skip the ETH/USD price request (stable pairs then count by buyers only).
NARRA_NO_USD=0

# --- semantic layer (optional, off by default) --------------------------------------------------------
# NARRA_SEMANTIC=on                     master switch
# NARRA_SEMANTIC_EMBED=local            local | openai | off   (local = transformers.js, multilingual-e5-small, CPU, ~120 MB once)
# NARRA_SEMANTIC_NAME=off               off | openai | anthropic   (label + one-line summary per published cluster)
# NARRA_SEMANTIC_URL=https://api.openai.com/v1   any OpenAI-compatible server: OpenAI, Ollama (http://127.0.0.1:11434/v1), LM Studio, OpenRouter
# NARRA_SEMANTIC_KEY=                   key for that server (Ollama needs none)
# NARRA_SEMANTIC_MODEL=                 chat model for naming (openai default gpt-4o-mini; anthropic default claude-opus-5, claude-haiku-4-5 is the cheap choice)
# NARRA_SEMANTIC_EMBED_MODEL=           embedding model (local default Xenova/multilingual-e5-small; remote default text-embedding-3-small)
# NARRA_SEMANTIC_THRESHOLD=0.86         cosine floor for a semantic link
# NARRA_SEMANTIC_BUDGET_PER_DAY=500     remote naming calls per day
# ANTHROPIC_API_KEY=                    for NARRA_SEMANTIC_NAME=anthropic (or use `ant auth login`)
